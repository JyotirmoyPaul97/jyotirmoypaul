# Optional Supabase integration (not active in demo mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-side model integration
MODEL_ENDPOINT=
MODEL_API_KEY=

# Frontend API base. Vite defaults to localhost:8000 in development;
# set this to the public backend URL in the Vercel frontend project's env.
VITE_API_BASE_URL=http://localhost:8000
# Comma-separated exact origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Optional regex for Vercel preview origins; prefer an exact production origin in CORS_ORIGINS.
CORS_ORIGIN_REGEX=
